# Copy to a protected deployment secret source; never commit populated values.
APP_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=mysql://db_steward:replace@system-mysql:3306/db_steward?serverVersion=8.4&charset=utf8mb4
MESSENGER_TRANSPORT_DSN=amqp://db_steward:replace@rabbitmq:5672/%2f/messages
MYSQL_DATABASE=db_steward
MYSQL_USER=db_steward
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
RABBITMQ_USER=db_steward
RABBITMQ_PASSWORD=replace-with-a-random-password
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
CLIENT_CREDENTIALS_KEY=replace-with-base64-encoded-32-byte-key
CENTRIFUGO_API_KEY=replace-with-at-least-32-random-characters
CENTRIFUGO_TOKEN_SECRET=replace-with-at-least-32-random-characters
TLS_CERTIFICATE_PATH=/absolute/path/to/fullchain.pem
TLS_PRIVATE_KEY_PATH=/absolute/path/to/privkey.pem
CENTRIFUGO_CONFIG_PATH=/absolute/path/to/production.json
